CompileFlags:
  Remove:
    - -forward-unknown-to-host-compiler
    - --generate-code*
    - -rdc=*
    - -G
    - --expt-*
    - -Xcompiler*
    - -Xcudafe*
    - -Xptxas*
  Add:
    - --cuda-path=/usr/local/cuda-13.2
    - --cuda-gpu-arch=sm_90
    - --no-cuda-version-check
    - -Wno-unknown-cuda-version
    - -DCCCL_DISABLE_NVFP6_SUPPORT
